<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Location is foreground only (owner requirement): fine and coarse, never background location and never a
         location foreground service. ManifestTest checks the merged manifest, libraries included. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Reads the location stored inside photos picked from the gallery, so they keep the spot they were taken (R52).
         It doesn't track the phone: that is the two permissions above, while the app is on screen. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No backup: the session token is encrypted with a key that never leaves this phone's keystore. -->
    <application
        android:name=".FieldmaxxApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.Fieldmaxx">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share target: "Share → Fieldmaxx" on a job file (PDF, Word) or a link. application/* also takes a PDF and a
                 Word file shared together, and files their app can't type; the app reads each file's name or first bytes
                 and refuses anything but PDF and .docx. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Hands files to other apps: the share sheet, the APK installer, document viewers. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
